# graph.rules — the decisions the code can't express (SDD doc 09 §4).
# Everything else about the graph is inferred from declarations.
# Dev-side compile input: these strings never reach generated code or the APK.

# Classes resolved only at runtime (`by injected()` / `Kite.get`) — invisible
# to static inference, so they are declared as roots.
root  com.kite.demo.di.AppInitializer
root  com.kite.demo.di.SessionCart
root  com.kite.demo.ui.FirstPresenter
root  com.kite.demo.ui.SecondPresenter

# Lifetimes beyond the defaults (interface implementations = singleton,
# everything else unscoped).


# A custom lifetime: opened at login via Kite.openScope, closed on logout.
scope com.kite.demo.di.SessionCart      -> Session:10
