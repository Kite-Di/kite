<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.kite.demo.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.kite.demo.SecondFragment"
        android:label="@string/second_fragment_label">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <!-- Feature screens live in their :feature:*:impl modules; the app shell
         only routes to them (bottom navigation — ids match bottom_nav_menu). -->
    <fragment
        android:id="@+id/OrdersFragment"
        android:name="com.kite.demo.feature.orders.impl.OrdersFragment"
        android:label="@string/orders_fragment_label" />
    <fragment
        android:id="@+id/ProfileFragment"
        android:name="com.kite.demo.feature.profile.impl.ProfileFragment"
        android:label="@string/profile_fragment_label" />
</navigation>